# ============ LLM backend (any OpenAI-compatible server) ============
# Option A - local Ollama (no quota, no cost; needs `ollama serve` and a pulled model):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
LLM_JSON_MODE=1
LLM_TIMEOUT=900
# Option B - OpenRouter (free models are limited to 50 requests/day without credits):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key
# LLM_MODEL=provider/model-name:free
# LLM_FALLBACK_MODELS=other/model:free,another/model:free

# ============ Literature APIs ============
CONTACT_EMAIL=your_real_email@example.org
NCBI_API_KEY=

# ============ Pipeline options (all optional) ============
# SCREEN_MODEL_B=            # second, different model for screening reviewer B (more independent agreement)
# SCREEN_LIMIT=20            # screen only the first N records (quick tests)
# EXTRACT_LIMIT=10           # extract only the first N included records
# HUMAN_APPROVAL=1           # pause after the protocol and after the grouping so you can edit the files

# ============ Synthesis and critic ============
# SYNTH_GROUP_BY=auto        # auto | modality | task
CRITIC_CITATION_SCOPE=inherit   # paragraph | inherit | sentence  (inherit = best measured trade-off)
CRITIC_SEMANTIC=1               # also run an LLM check of every passage (slower, noisier with small models)
CRITIC_LLM_REWRITES=0           # 0 = LLM findings are advisory and do not trigger rewrites
# CRITIC_MODEL=                 # model for the LLM check (default: LLM_MODEL)
# MAX_REVISIONS=2
